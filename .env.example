# Copier ce fichier en .env et remplacer les valeurs. Le fichier .env n'est jamais versionné.

# Base de données
POSTGRES_DB=absences
POSTGRES_USER=absences_owner
POSTGRES_PASSWORD=a_changer
APP_DB_USER=absences_app
APP_DB_PASSWORD=a_changer_aussi

# Envoi des e-mails (ignoré en développement, où Mailpit prend le relais)
SMTP_HOST=smtp.exemple.interne
SMTP_PORT=25
SMTP_FROM=absences@exemple.fr
# Facultatifs, selon votre serveur :
#   SMTP_USER / SMTP_PASSWORD : si le serveur exige un identifiant
#   SMTP_SECURE=true          : TLS dès la connexion (en général port 465) ; sinon STARTTLS si le serveur le propose
#   SMTP_TLS_VERIFIER=false   : accepter un certificat interne non reconnu (à éviter hors réseau de confiance)
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_TLS_VERIFIER=

# Adresse publique de l'application, sans barre finale, EXACTEMENT telle qu'on la saisit dans le navigateur
# (schéma, adresse et port). En production elle doit être en HTTPS.
# En HTTP (essais sur le réseau local), mots de passe et sessions circulent en clair.
APP_URL=https://absences.exemple.fr

# Durée d'une session, en heures
SESSION_DUREE_HEURES=12

# Connexion par compte Microsoft (facultative : laisser vide pour la désactiver).
# Application à déclarer dans Entra ID, en mono-locataire, avec l'adresse de redirection
# <APP_URL>/api/auth/microsoft/retour
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# MODE TEST : met sur la page de connexion une liste de tous les comptes, pour s'y connecter SANS mot de passe.
# Mettre « true » pour des essais, puis le retirer. Ne jamais l'activer sur une installation accessible à d'autres.
AUTOLOGIN_TEST=

# Port publié par le conteneur web
WEB_PORT=8080
